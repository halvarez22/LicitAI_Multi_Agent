{
  "policy_version": "evidence-anchor-v1.0.0",
  "description": "HRU universal: reglas de calidad y precedencia para anclas de bases. Sin mapas por convocante.",
  "schema_version": "evidence-anchor-v1.0.0",
  "min_snippet_len": 12,
