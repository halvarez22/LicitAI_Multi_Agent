  "training_flows": [
    {
      "id": "flow_chat_economic",
      "title": "Cotizar conversando (copiloto económico)",
      "steps": [
        "Analizar bases con empresa seleccionada",
        "Responder precios en chat o pegar TSV",
        "Verificar matriz, totales y provenance_ui",
        "Generar económica cuando la cola lo permita"
      ]
    },
    {
      "id": "flow_technical_copilot",
      "title": "Completar técnica conversando (copiloto técnico)",
      "steps": [
        "Tras análisis, leer slots pendientes (metodología, personal, etc.)",
        "Capturar con prefijos: metodologia:, personal:",
        "Consultar estado o dual: «cómo vamos técnica y económica»",
        "Generar técnica cuando capture_complete"
      ]
    },
    {
      "id": "flow_parallel_dual",
      "title": "Streams paralelos técnica + económica (F6)",
      "steps": [
        "Completar capturas en chat (flujos 1 y 2)",
        "Lanzar TÉCNICA y ECONÓMICA en paralelo desde panel Fuentes",
        "Verificar colas independientes y jobs omitidos por modo",
        "Descargar expediente parcial; completar empaquetado estricto post sign-off"
      ]
    }
